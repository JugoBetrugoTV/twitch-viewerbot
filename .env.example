# Battle.net API credentials.
# Create a client at https://develop.battle.net/access/clients
# (Redirect URI can be http://localhost - client-credentials flow does not use it.)
BNET_CLIENT_ID=your_client_id_here
BNET_CLIENT_SECRET=your_client_secret_here

# Default region when the UI doesn't specify one: us | eu | kr | tw
DEFAULT_REGION=eu

# Locale for names/tooltips, e.g. en_US, en_GB, de_DE, fr_FR
LOCALE=en_US

# Port for the local web server
PORT=3000
